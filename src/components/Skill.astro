---
import { Icon } from "astro-iconify";

interface Props {
  icon: string;
}

const { icon } = Astro.props;
---

<div class="skill"><Icon name={icon} /><slot /></div>

<style lang="scss">
  .skill {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5em;
    transition: color 0.2s;
    color: silver;
    font-style: italic;
    font-size: 0.75em;
    user-select: none;

    > svg:first-child {
      $size: clamp(3.5rem, 10vw, 4rem);
      filter: drop-shadow(0 0 4px black);
      transition:
        filter 0.2s,
        translate 0.2s;
      width: $size;
      height: $size;
    }

    &:hover {
      color: white;

      > svg:first-child {
        translate: 0 -0.25rem;
        filter: drop-shadow(0 0 4px teal);
      }
    }

    &:active {
      > svg:first-child {
        translate: 0 -0.5rem;
      }
    }
  }
</style>
