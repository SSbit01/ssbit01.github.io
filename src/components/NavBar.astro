---
import { Icon } from "astro-iconify";
---

<nav id="navbar">
  {
    [
      {
        name: "Home",
        icon: "ph:house-duotone"
      },
      {
        name: "About",
        icon: "bi:person-lines-fill"
      },
      {
        name: "Projects",
        icon: "ph:code-duotone"
      },
      {
        name: "Contact",
        icon: "ic:baseline-contact-mail"
      }
    ].map(({ name, icon }) => (
      <a href={`#${name.toLowerCase()}`}>
        <>
          <Icon name={icon} />
          <span class="nav-text">{name}</span>
        </>
      </a>
    ))
  }
</nav>

<script>
  const navBarEl = document.getElementById("navbar");

  if (navBarEl) {
    const navLinkEls = Array.from(navBarEl.children),
      sectionEls = Array.from(document.querySelectorAll<HTMLElement>(navLinkEls.map(a => a.getAttribute("href")).join(",")));

    function onScroll() {
      // Scroll Indicator
      navBarEl?.style.setProperty(
        "--scroll-indicator",
        (document.documentElement.scrollTop / (document.documentElement.scrollHeight - document.documentElement.clientHeight)) * 100 + "%"
      );

      // Nav-Link Active
      const id = sectionEls.find(
          ({ offsetTop, offsetHeight }) => scrollY + innerHeight - (navBarEl?.offsetHeight || 0) - 3 <= offsetTop + offsetHeight
        )?.id,
        activeNavClass = "active";

      navLinkEls.forEach(a => {
        if (id && a.getAttribute("href")?.includes(id)) {
          a.classList.add(activeNavClass);
        } else {
          a.classList.remove(activeNavClass);
        }
      });
    }

    new ResizeObserver(onScroll).observe(document.body, { box: "border-box" }); // Trigger onScroll when document height changes
    window.addEventListener("scroll", onScroll);
  }
</script>

<style lang="scss">
  #navbar {
    --scroll-indicator: 100%;
    display: flex;
    position: sticky;
    bottom: 0;
    transform-origin: bottom;
    z-index: 2;
    animation: 1.75s ease navbar-anim1;
    border-top: thin solid #2f4f4f;

    &::before {
      position: absolute;
      content: "";
      $height-bar: 3px; // Variable
      top: -$height-bar;
      z-index: 1;
      animation: 2.75s ease fill;
      box-shadow: 0 2px 3px #000;
      background: #ffd700;
      width: var(--scroll-indicator);
      height: $height-bar;
    }

    > a {
      display: flex;
      flex: 1;
      justify-content: center;
      align-items: flex-end;
      gap: 0.25em;
      backdrop-filter: blur(2px);
      transition-duration: 0.15s;
      transition-property: color, background, font-weight;
      padding: 0.5em;
      font-size: clamp(1em, 4.5vw, 1.5em);
      text-decoration: none;
      text-transform: capitalize;

      .nav-text {
        transition: font-size 0.15s;
      }

      &.active {
        background: #66cdaa;
        color: #000;
        font-weight: 500;

        &:hover {
          background: #73e6be;
        }
        &:active {
          background: #7fffd4;
        }
      }

      &:not(.active) {
        background: #0a0f14e6;
        color: #dcdcdc;

        &:hover {
          background: #14191ee6;
          color: #fff;
        }
        &:active {
          background: #191e23e6;
          color: #fff;
        }
      }

      > svg {
        width: 1.2em;
      }
    }
  }

  @keyframes navbar-anim1 {
    0%,
    75% {
      transform: translateY(100%);
      opacity: 0;
    }
  }

  @keyframes fill {
    0%,
    65% {
      width: 0;
    }
  }

  @media (max-width: 675px) {
    #navbar {
      > a {
        flex-direction: column;
        align-items: center;
        gap: 0;
        padding: 0.75em;
        font-size: 0.75em;

        .nav-text {
          font-size: 0;
        }
        > svg {
          width: 2.5em;
        }
      }
      &:hover > a .nav-text {
        font-size: 1em;
      }
    }
  }
</style>
