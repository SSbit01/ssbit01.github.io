---
import { Icon } from "astro-iconify";
---

<nav id="navbar">
  {
    [
      {
        name: "Home",
        icon: "ph:house-duotone"
      },
      {
        name: "About",
        icon: "bi:person-lines-fill"
      },
      {
        name: "Projects",
        icon: "ph:code-duotone"
      },
      {
        name: "Contact",
        icon: "ic:baseline-contact-mail"
      }
    ].map(({ name, icon }) => (
      <a href={`#${name.toLowerCase()}`}>
        <>
          <Icon name={icon} />
          <span class="nav-text">{name}</span>
        </>
      </a>
    ))
  }
</nav>

<script>
  const navBarEl = document.getElementById("navbar");

  if (navBarEl) {
    const activeNavClass = "active";
    const navLinkEls = Array.from(navBarEl.children);
    const sectionEls = document.querySelectorAll(navLinkEls.map(a => a.getAttribute("href")).join(","));

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const { id } = entry.target;

        if (entry.isIntersecting) {
          navLinkEls.forEach((a) => {
            if (a.getAttribute("href")?.includes(id)) {
              a.classList.add(activeNavClass);
            }
          });
        } else {
          navLinkEls.forEach((a) => {
            if (a.getAttribute("href")?.includes(id)) {
              a.classList.remove(activeNavClass);
            }
          });
        }
      });
    }, {
      root: null,
      rootMargin: `-200px 0px -${navBarEl.offsetHeight + 100}px 0px`,
      threshold: 0
    });

    sectionEls.forEach((section) => observer.observe(section));
  }
</script>

<style lang="scss">
  #navbar {
    display: flex;
    position: sticky;
    bottom: 0;
    transform-origin: bottom;
    z-index: 2;
    animation: 1.75s ease navbar-anim1;
    border-top: thin solid #2f4f4f;

    > a {
      display: flex;
      flex: 1;
      justify-content: center;
      align-items: flex-end;
      gap: 0.25em;
      backdrop-filter: blur(2px);
      transition-duration: 0.15s;
      transition-property: color, background, font-weight;
      padding: 0.5em;
      font-size: clamp(1em, 4.5vw, 1.5em);
      text-decoration: none;
      text-transform: capitalize;

      .nav-text {
        transition: font-size 0.15s;
      }

      &.active {
        background: #66cdaa;
        color: #000;
        font-weight: 500;

        &:hover {
          background: #73e6be;
        }
        &:active {
          background: #7fffd4;
        }
      }

      &:not(.active) {
        background: #0a0f14e6;
        color: #dcdcdc;

        &:hover {
          background: #14191ee6;
          color: #fff;
        }
        &:active {
          background: #191e23e6;
          color: #fff;
        }
      }

      > svg {
        width: 1.2em;
      }
    }
  }

  @keyframes navbar-anim1 {
    0%,
    75% {
      transform: translateY(100%);
      opacity: 0;
    }
  }

  @media (max-width: 675px) {
    #navbar {
      > a {
        flex-direction: column;
        align-items: center;
        gap: 0;
        padding: 0.75em;
        font-size: 0.75em;

        .nav-text {
          font-size: 0;
        }
        > svg {
          width: 2.5em;
        }
      }
      &:hover > a .nav-text {
        font-size: 1em;
      }
    }
  }
</style>
