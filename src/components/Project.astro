---
import { Icon } from "astro-iconify";

interface Props {
  name: string;
  source: string;
  website?: string;
}

function toTag(str: string) {
  return str.toLowerCase().replaceAll(/\W/g, "-");
}

const { name, source, website } = Astro.props;
const id = toTag(name);
---

<figure class="project">
  <img src={`/images/projects/${id}.webp`} alt="Project Image" loading="lazy" draggable={false} />

  <figcaption>
    <h2 class="project-title">{name}</h2>

    {
      Astro.slots.has("default") && (
        <div class="description">
          <slot />
        </div>
      )
    }

    <div class="links">
      <a href={source} target="_blank" rel="noreferrer noopener" title="Source">
        <Icon name="fluent:code-24-filled" /><span class="link-text">Source</span>
      </a>
      {
        website && (
          <a href={website} target="_blank" rel="noreferrer noopener" title="Website">
            <>
              <span class="link-text">Website</span>
              <Icon name="lucide:external-link" />
            </>
          </a>
        )
      }
    </div>
  </figcaption>
</figure>

<style lang="scss">
  .project {
    display: flex;
    position: relative;
    flex-direction: column;
    transition: box-shadow 0.2s;
    box-sizing: border-box;
    margin: 0;
    box-shadow: 0 0 0.25em #008b8b;
    height: 100%;
    overflow: hidden;

    > img {
      aspect-ratio: 16 / 9;
      width: 100%;
      user-select: none;
    }

    > figcaption {
      display: flex;
      flex: 1;
      flex-direction: column;
      gap: clamp(0.75em, 2vw, 1em);
      padding: 1em;
      padding-block-end: 1.5em;
      overflow: auto;
    }
  }

  .project-title {
    margin: 0;
    color: #c8ffe1;
    font-size: 1.75em;
    text-align: center;
    text-shadow: 0 0 6px #008080;
  }

  .description {
    display: grid;
    gap: 0.625em;
    margin-inline: auto;
    line-height: 1.5;
    > :global(p) {
      margin: 0;
    }

    :global(a) {
      transition: text-shadow 0.2s;
      color: #40e0d0;
      text-decoration: none;

      &:hover,
      &:active {
        text-decoration: underline;
      }
      &:active {
        text-shadow: 0 0 4px;
      }
    }
  }

  .links {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2em;
    margin-block-start: auto;
    padding-block-start: 0.5em;
    font-size: 1.1875em;
    > a {
      display: flex;
      align-items: center;
      gap: 0.5em;
      transition:
        color 0.15s,
        filter 0.15s;
      color: #ffd700;
      text-decoration: none;

      > svg {
        filter: drop-shadow(0 0 4px #000);
        width: 1.25em;
      }

      &:is(:hover, :active, :focus) {
        color: #ff0;
      }

      &:is(:active, :focus) {
        filter: drop-shadow(0 0 0.25em #ffd700) !important;
      }
    }
  }

  @media (width > 35em) {
    .links {
      padding-inline: 1em;
    }

    .project {
      border-radius: 1em;
      max-width: 32em;
    }
  }
</style>
