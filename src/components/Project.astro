---
import { Icon } from "astro-iconify";

interface Props {
  name: string;
  tags?: string[];
  source: string;
  website?: string;
}

function toTag(str: string) {
  return str.toLowerCase().replaceAll(/\W/g, "-");
}

const { name, tags, source, website } = Astro.props,
  id = toTag(name);
---

<figure class="project" tabindex="0">
  <img src={`/images/projects/${id}.webp`} alt="" loading="lazy" draggable={false} />

  <figcaption>
    <h2 class="project-title">{name}</h2>

    {
      tags?.length && (
        <ul class="tags">
          {tags.map(tag => (
            <li>{toTag(tag)}</li>
          ))}
        </ul>
      )
    }

    {
      Astro.slots.has("default") && (
        <div class="description">
          <slot />
        </div>
      )
    }

    <div class="links">
      {
        [
          { href: source, title: "Source", icon: "fluent:code-24-filled" },
          { href: website, title: "Website", icon: "lucide:external-link" }
        ].map(({ href, title, icon }) => (
          <a href={href} target="_blank" rel="noreferrer noopener" title={title}>
            <Icon name={icon} />
          </a>
        ))
      }
    </div>
  </figcaption>
</figure>

<style lang="scss">
  .project {
    position: relative;
    transition: box-shadow 0.2s;
    margin: 0;
    box-shadow:
      inset 0 0 4px #2f4f4f,
      0 0 1px #008b8b;
    overflow: hidden;
    text-align: center;

    > img {
      vertical-align: top; // PREVENTS EXTRA WHITE SPACE
      transition: filter 0.2s;
      aspect-ratio: 16 / 9;
      width: 48em;
      max-width: 100%;
      user-select: none;
    }

    > figcaption {
      display: flex;
      position: absolute;
      flex-direction: column;
      gap: clamp(0.75em, 2vw, 1em);
      transform-origin: bottom;
      transition-duration: 0.4s;
      transition-property: visibility, opacity, scale;
      inset: 0;
      padding: clamp(1rem, 5vw, 2rem);
      padding-bottom: clamp(1.25rem, 5vw, 2rem);
      overflow: auto;
      font-size: clamp(0.9em, 3.4vw, 1em);
    }

    &:hover,
    &:focus-within {
      > img {
        filter: blur(8px) brightness(0.3);
      }
    }

    &:not(:hover):not(:focus-within) {
      > figcaption {
        scale: 0.9;
        visibility: hidden;
        opacity: 0;
      }
    }

    &:focus-within {
      outline: none;
      box-shadow: inset 0 0 1px 4px #00fa9a;
    }
  }

  .project-title {
    margin-top: auto;
    margin-bottom: 0;
    color: #c8ffe1;
    font-size: clamp(1.5em, 5.75vw, 3em);
    text-shadow: 0 0 6px #008080;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5em 0.75em;
    padding-left: 0;
    font-size: clamp(0.85em, 2vw, 1em);
    list-style: none;

    > li {
      color: #7fffd4;
      text-shadow: 0 0 6px #000;

      &::before {
        content: "#";
        color: #20b2aa;
      }
    }
  }

  .description {
    display: grid;
    gap: 0.5em;
    margin-top: 0.5em;
    line-height: 1.5;

    > :global(p) {
      margin: 0;
    }

    :global(a) {
      transition: text-shadow 0.2s;
      color: #40e0d0;
      text-decoration: none;

      &:hover,
      &:active {
        text-decoration: underline;
      }
      &:active {
        text-shadow: 0 0 4px;
      }
    }
  }

  .links {
    display: flex;
    justify-content: space-evenly;
    align-items: center;
    margin: auto 0;

    > a {
      display: flex;
      flex-direction: column;
      align-items: center;
      color: #ff0;
      text-decoration: none;

      > svg:first-child {
        $size: clamp(2em, 7vw, 3em);
        translate: 0 0.5em;
        filter: drop-shadow(0 0 4px #000);
        transition:
          filter 0.2s,
          translate 0.2s;
        width: $size;
        height: $size;
        color: #ffd700;
      }

      &::after {
        opacity: 0;
        transition:
          text-shadow 0.2s,
          opacity 0.2s;
        margin: 0;
        content: attr(title);
        font-size: 0.75em;
        text-shadow: 0 0 0.25em #000;
      }

      &:hover {
        > svg:first-child {
          translate: 0;
        }
        &::after {
          opacity: 1;
        }
      }

      &:active {
        > svg:first-child {
          translate: 0 -0.25em;
          filter: drop-shadow(0 0 0.25em);
        }
        &::after {
          opacity: 1;
          text-shadow: 0 0 0.25em;
        }
      }
    }
  }
</style>
