---
import { Icon } from "astro-iconify";

interface Props {
  name: string;
  tags?: string[];
  source: string;
  website?: string;
}

function toTag(str: string) {
  return str.toLowerCase().replaceAll(/\W/g, "-");
}

const { name, tags, source, website } = Astro.props,
  id = toTag(name);
---

<figure class="project">
  <img src={`/images/projects/${id}.webp`} alt="Project Image" loading="lazy" draggable={false} />

  <figcaption>
    <h2 class="project-title">{name}</h2>

    {
      Astro.slots.has("default") && (
        <div class="description">
          <slot />
        </div>
      )
    }

    <div class="links">
      {
        [
          { href: source, title: "Source", icon: "fluent:code-24-filled" },
          { href: website, title: "Website", icon: "lucide:external-link" }
        ].map(({ href, title, icon }) => (
          <a href={href} target="_blank" rel="noreferrer noopener" title={title}>
            <Icon name={icon} />
          </a>
        ))
      }
    </div>
  </figcaption>
</figure>

<style lang="scss">
  .project {
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    position: relative;
    transition: box-shadow 0.2s;
    margin: 0;
    box-shadow: 0 0 0.25em #008b8b;
    overflow: hidden;

    > img {
      vertical-align: top; // PREVENTS EXTRA WHITE SPACE
      aspect-ratio: 16 / 9;
      max-width: 100%;
      user-select: none;
    }

    > figcaption {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: clamp(0.75em, 2vw, 1em);
      overflow: auto;
      padding: 1em;
    }
  }

  .project-title {
    margin: 0;
    color: #c8ffe1;
    font-size: 1.75em;
    text-align: center;
    text-shadow: 0 0 6px #008080;
  }

  .description {
    display: grid;
    gap: 0.625em;
    line-height: 1.5;
    margin-inline: auto;
    > :global(p) {
      margin: 0;
    }

    :global(a) {
      transition: text-shadow 0.2s;
      color: #40e0d0;
      text-decoration: none;

      &:hover,
      &:active {
        text-decoration: underline;
      }
      &:active {
        text-shadow: 0 0 4px;
      }
    }
  }

  .links {
    display: flex;
    justify-content: space-evenly;
    align-items: center;
    margin-block-start: auto;
    > a {
      display: flex;
      flex-direction: column;
      align-items: center;
      color: #ff0;
      text-decoration: none;

      > svg:first-child {
        $size: clamp(2em, 7vw, 2.5em);
        translate: 0 0.5em;
        filter: drop-shadow(0 0 4px #000);
        transition:
          filter 0.2s,
          translate 0.2s;
        width: $size;
        height: $size;
        color: #ffd700;
      }

      &::after {
        opacity: 0;
        transition:
          text-shadow 0.2s,
          opacity 0.2s;
        margin: 0;
        content: attr(title);
        font-size: 0.75em;
        text-shadow: 0 0 0.25em #000;
      }

      &:hover {
        > svg:first-child {
          translate: 0;
        }
        &::after {
          opacity: 1;
        }
      }

      &:active {
        > svg:first-child {
          translate: 0 -0.25em;
          filter: drop-shadow(0 0 0.25em);
        }
        &::after {
          opacity: 1;
          text-shadow: 0 0 0.25em;
        }
      }
    }
  }

  @media (width > 35em) {
    .project {
      max-width: 32em;
      border-radius: 1em;
    }
  }
</style>
