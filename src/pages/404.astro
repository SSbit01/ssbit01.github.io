---
import { Font } from "astro:assets";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="dark light" />

    <link rel="shortcut icon" href="/favicon.ico" />

    <title>404 (Not Found)</title>

    <Font cssVariable="--font-jura" preload />
  </head>

  <body>
    <hgroup class="header-group">
      <h1>404</h1>
      <p>Yes, that's an <strong>error</strong></p>
    </hgroup>

    <p class="message">
      This is not the page you are looking for. It seems you have entered a wormhole and ended up in the wrong dimension.
    </p>

    <a class="go-back" href="/">Head Back Now!</a>
  </body>
</html>

<style lang="scss">
  body {
    margin: 3em 1em;
    background: rgb(5, 15, 25);
    font-family: var(--font-jura), Calibri, Arial, sans-serif;
    text-align: center;
  }

  .header-group {
    > h1 {
      margin: 0;
      color: mediumaquamarine;
      font-size: 8em;
      text-shadow: 0 0 6px;
    }
    > p {
      margin: 0;
      color: crimson;
    }
  }

  .message {
    margin: 1em auto;
    max-width: 35em;
    font-size: 1.5em;
    line-height: 1.5;
  }

  .go-back {
    position: relative;
    transition-duration: 0.2s;
    transition-property: color, text-shadow;
    background: inherit;
    color: cadetblue;
    font-size: 1.5em;
    text-decoration: none;
    white-space: nowrap;

    &::after {
      position: absolute;
      right: 0;
      bottom: -2px;
      left: 0;
      transform: scaleX(0);
      transform-origin: center;
      transition: transform 0.2s;
      border-radius: 2px;
      background: mediumturquoise;
      height: 2px;
      content: "";
    }

    &:hover::after {
      transform: scaleX(1);
    }

    &:active {
      color: lightseagreen;
      text-shadow: 0 0 4px;
    }
  }
</style>
