---
import Project from "#src/components/Project.astro";
---

<script>
  document.getElementById("more-projects-details")?.addEventListener("toggle", function (event) {
    const el = event.target as HTMLDetailsElement;

    if (el.open) {
      el.scrollIntoView(true);
    }
  });
</script>

<section id="projects">
  <div class="featured-project">
    <img
      alt="profile.rocks example"
      class="featured-project-img"
      draggable={false}
      loading="lazy"
      src="/images/projects/profile.rocks.webp"
    />
    <div class="featured-project-content">
      <hgroup>
        <h1 class="featured-project-title">profile.rocks</h1>
        <p class="featured-project-indicator">Featured project</p>
      </hgroup>
      <h3 class="featured-project-slogan">The Map of Your Online Presence</h3>
      <p>
        A platform that enables users to easily create profiles and micropages using Markdown. Built with <strong>Next.js</strong> (Front-End)
        and <strong>Bun</strong> (Back-End), it features:
      </p>
      <ul class="featured-project-features">
        <li>Secure session management</li>
        <li>Payment processing via Polar.sh</li>
        <li>Efficient client-side state management</li>
      </ul>
      <div>
        <a class="featured-project-link" href="https://www.profile.rocks/" target="_blank" rel="noreferrer noopener">Visit website</a>
      </div>
    </div>
  </div>
  <h2 class="title-other-projects">Other projects</h2>
  <ul class="project-list">
    <li>
      <Project name="Secure OTP Server" source="https://github.com/SSbit01/secure-otp-server">
        <p>
          Template server for generating and verifying One-Time Passwords (OTP) for credential verification. Designed for microservices,
          modern authentication flows, and serverless environments.
        </p>
      </Project>
    </li>
    <li>
      <Project name="Secure Bun Server" source="https://github.com/SSbit01/secure-bun-server">
        <p>
          Template with passwordless authentication via email, KMS, and a MariaDB/MySQL database configured in Bun. Perfect for building
          performant and secure platform servers.
        </p>
      </Project>
    </li>
    <li>
      <Project name="Voting App" source="https://github.com/SSbit01/voting-app" website="https://voting-app-iota.vercel.app/">
        <p>
          Full-stack for user poll creation and open voting that features advanced modal-based interactions. Built with Next.js, Tailwind
          CSS, and MongoDB.
        </p>
      </Project>
    </li>
    <li>
      <Project name="HandyVoid" source="https://github.com/HandyVoid/HandyVoidium" website="https://www.handyvoid.com/">
        <p>
          Multilingual platform built with Nuxt.js that offers a comprehensive set of tools for a wide range of tasks. It aims to provide
          users with a single platform where they can find all the tools they need without having to navigate through multiple websites.
        </p>
      </Project>
    </li>
    <li>
      <Project
        name="Simple Chat Rooms"
        source="https://github.com/SSbit01/Simple-Chat-Rooms"
        website="https://simple-chat-rooms.onrender.com/"
      >
        <p>
          Real-time chat platform that allows users to create and join chat rooms without account creation, built with Vue, Node.js, and
          Socket.IO.
        </p>
        <p><strong>Note:</strong> Due to the free tier limitations of Render, it may take a few seconds to wake up the platform.</p>
      </Project>
    </li>
    <li>
      <Project
        name="ISAL"
        source="https://github.com/SSbit01/Image-Search-Abstraction-Layer"
        website="https://image-search-abstraction-layer.onrender.com/"
      >
        <p>Intuitive image search application powered by the Pixabay API, built with Express, Pug, and Bootstrap.</p>
        <p><strong>Note:</strong> Due to the free tier limitations of Render, it may take a few seconds to wake up the platform.</p>
      </Project>
    </li>
  </ul>

  <details id="more-projects-details">
    <summary>CodePens</summary>
    <ul class="project-list">
      <li>
        <Project name="Game Of Life" source="https://codepen.io/ssbit01/pen/YzZRQNV" website="https://codepen.io/ssbit01/full/YzZRQNV">
          <p>
            My own implementation of <a
              href="https://en.wikipedia.org/wiki/Conway%27s_Game_of_Life"
              target="_blank"
              rel="noreferrer noopener">Conway's Game Of Life</a
            > built with Vue.
          </p>
        </Project>
      </li>
      <li>
        <Project name="Wikipedia Viewer" source="https://codepen.io/ssbit01/pen/dyNJwxv" website="https://codepen.io/ssbit01/full/dyNJwxv">
          <p>
            A fast, response & elegant page that lets you search and browse Wikipedia articles with ease. Built with Bootstrap and
            JavaScript.
          </p>
        </Project>
      </li>
      <li>
        <Project
          name="Scatterplot: Doping in Professional Bicycle Racing"
          source="https://codepen.io/ssbit01/pen/qBaorjO"
          website="https://codepen.io/ssbit01/full/qBaorjO"
        />
      </li>
      <li>
        <Project
          name="Bar Chart: U.S. GDP"
          source="https://codepen.io/ssbit01/pen/poEdPWW"
          website="https://codepen.io/ssbit01/full/poEdPWW"
        />
      </li>
      <li>
        <Project
          name="Choropleth Map: U.S. Educational Attainment"
          source="https://codepen.io/ssbit01/pen/gOwZzEZ"
          website="https://codepen.io/ssbit01/full/gOwZzEZ"
        />
      </li>
      <li>
        <Project
          name="Heatmap: Monthly Global Land-Surface Temperature"
          source="https://codepen.io/ssbit01/pen/eYdKxMO"
          website="https://codepen.io/ssbit01/full/eYdKxMO"
        />
      </li>
      <li>
        <Project name="Simon Game" source="https://codepen.io/ssbit01/pen/poePVeV" website="https://codepen.io/ssbit01/full/poePVeV" />
      </li>
      <li>
        <Project
          name="Random Quote Machine"
          source="https://codepen.io/ssbit01/pen/JjGZmrd"
          website="https://codepen.io/ssbit01/full/JjGZmrd"
        />
      </li>
      <li>
        <Project
          name="Password Generator"
          source="https://codepen.io/ssbit01/pen/RwVOaKw"
          website="https://codepen.io/ssbit01/full/RwVOaKw"
        />
      </li>
      <li>
        <Project name="25 + 5 Clock" source="https://codepen.io/ssbit01/pen/QWKGEVQ" website="https://codepen.io/ssbit01/full/QWKGEVQ" />
      </li>
      <li>
        <Project
          name="Rock Paper Scissors (Lizard Spock)"
          source="https://codepen.io/ssbit01/pen/xxjpVoR"
          website="https://codepen.io/ssbit01/full/xxjpVoR"
        />
      </li>
      <li>
        <Project name="Intro to Python" source="https://codepen.io/ssbit01/pen/RwNzXrB" website="https://codepen.io/ssbit01/full/RwNzXrB">
          <p>My own basic <strong>Python</strong> documentation.</p>
        </Project>
      </li>
    </ul>
  </details>
</section>

<style lang="scss">
  p {
    line-height: 1.5;
  }

  #projects {
    border-bottom: thin solid #00fa9a;
    background: #0f1923;
    padding-top: 2.75em;
    padding-bottom: 5em;
  }

  #more-projects-details {
    margin-top: 3em;
    scroll-margin-top: 2em;
    > summary:first-child {
      box-shadow: 0 0 3px #008080;
      border-radius: 8px;
      background: #66cdaa;
      padding: 0.25em 0.5em;
      max-width: max-content;
      color: #000000;
      font-size: clamp(1.5em, 7vw, 2em);
      list-style: none;
      text-align: center;
      $mx: auto;
      transition-duration: 0.15s;
      transition-property: background, box-shadow, scale;
      cursor: pointer;
      margin: 0 $mx 2rem $mx;
      user-select: none;
      &::before {
        display: inline-block;
        transition: transform 0.15s;
        margin-right: 0.25em;
        content: ">";
        font-weight: 500;
      }
      &:hover {
        box-shadow: 0 0 8px #00fa9a;
        background: #7fffd4;
      }
      &:active {
        scale: 0.95;
      }
    }
    &[open] {
      > summary:first-child {
        background: #0a0f19;
        color: #66cdaa;
        &::before {
          transform: rotate(90deg) translateX(1px);
        }
        &:hover {
          background: #141923;
        }
      }
    }
  }

  .featured-project {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1em 2em;
    margin-block: 0 4em;
  }

  .featured-project-content {
    padding-inline: 1em;
    max-width: 36.5em;
  }

  .featured-project-features {
    display: grid;
    gap: 0.75em;
    padding-inline-start: 1em;
    color: #dcdcdc;
    > li {
      &::marker {
        color: #00ced1;
      }
    }
  }

  .featured-project-img {
    box-shadow: 0 0 0.25em #008b8b;
    border-radius: 1em;
    max-width: 18em;
  }

  .featured-project-indicator {
    margin-block-start: 0;
    color: #ffd700;
    font-size: 1.5em;
    text-align: center;
  }

  .featured-project-link {
    display: block;
    transition: text-shadow 0.2s;
    margin-block-start: 1.5em;
    max-width: max-content;
    color: #40e0d0;
    font-size: 1.375em;
    text-decoration: none;

    &:hover,
    &:active {
      text-decoration: underline;
    }
    &:active {
      text-shadow: 0 0 4px;
    }
  }

  .featured-project-slogan {
    font-size: 1.5em;
    text-align: center;
  }

  .featured-project-title {
    margin-block: 0.25em 0.5em;
    color: #c8ffe1;
    font-size: 2.5em;
    text-align: center;
    text-shadow: 0 0 6px #008080;
  }

  .project-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin: auto;
    padding: 0;
    max-width: 100em;
    list-style: none;
  }

  .title-other-projects {
    margin-block-end: 1.25em;
    color: #00ced1;
    font-size: 2.5em;
    text-align: center;
  }

  @media (width > 35em) {
    .project-list {
      gap: 1.5em;
    }
  }

  @media (width > 62em) {
    .featured-project {
      flex-direction: row;
      align-items: flex-start;
    }

    .featured-project-indicator,
    .featured-project-slogan,
    .featured-project-title {
      text-align: start;
    }
  }
</style>
