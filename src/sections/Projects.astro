<style lang="scss">
  #projects {
    border-bottom: thin solid #00fa9a;
    background: #0f1923;
    padding-top: 2.75em;
    padding-bottom: 5em;
  }

  .section-header {
    gap: 0.3em;
    color: #00ced1;
    font-size: clamp(1.5em, 6.4vw, 2em);
    line-height: 1.5;
    text-align: center;
    $mx: 0.75em;
    margin: 0 $mx 1.25em $mx;
    > svg {
      display: inline-block;
      vertical-align: sub;
      margin: 0 0.3em;
      width: 1.25em;
      color: #40e0d0;
    }
  }

  .project-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin: auto;
    padding: 0;
    max-width: 90em;
    list-style: none;
  }

  #more-projects-details {
    margin-top: 3em;
    scroll-margin-top: 2em;
    > summary:first-child {
      box-shadow: 0 0 3px #008080;
      border-radius: 8px;
      background: #66cdaa;
      padding: 0.25em 0.5em;
      max-width: max-content;
      color: #000000;
      font-size: clamp(1.5em, 7vw, 2em);
      list-style: none;
      text-align: center;
      $mx: auto;
      transition-duration: 0.15s;
      transition-property: background, box-shadow, scale;
      cursor: pointer;
      margin: 0 $mx 2rem $mx;
      user-select: none;
      &::before {
        display: inline-block;
        transition: transform 0.15s;
        margin-right: 0.25em;
        content: ">";
        font-weight: 500;
      }
      &:hover {
        box-shadow: 0 0 8px #00fa9a;
        background: #7fffd4;
      }
      &:active {
        scale: 0.95;
      }
    }
    &[open] {
      > summary:first-child {
        background: #0a0f19;
        color: #66cdaa;
        &::before {
          transform: rotate(90deg) translateX(1px);
        }
        &:hover {
          background: #141923;
        }
      }
    }
  }

  @media (width > 35em) {
    .project-list {
      gap: 1.5em;
    }
  }
</style>
