---
import Project from "#src/components/Project.astro";
---

<script>
  document.getElementById("more-projects-details")?.addEventListener("toggle", function (event) {
    const el = event.target as HTMLDetailsElement;

    if (el.open) {
      el.scrollIntoView(true);
    }
  });
</script>

<section id="projects">
  <h1 class="section-header">These are some of my projects</h1>

  <ul class="project-list">
    <li>
      <Project name="Voting App" source="https://github.com/SSbit01/voting-app" website="https://voting-app-iota.vercel.app/">
        <p>
          A full-stack polling platform where users can create and participate in community driven polls. Built with Next.js and Tailwind
          CSS, the application uses MongoDB for data persistence and features advanced modal based interactions.
        </p>
      </Project>
    </li>
    <li>
      <Project name="HandyVoid" source="https://github.com/HandyVoid/HandyVoidium" website="https://www.handyvoid.com/">
        <p>
          A multilingual platform built with Nuxt.js that offers a comprehensive set of tools for a wide range of tasks. It aims to provide
          users with a single platform where they can find all the tools they need without having to navigate through multiple websites.
        </p>
      </Project>
    </li>
    <li>
      <Project
        name="Simple Chat Rooms"
        source="https://github.com/SSbit01/Simple-Chat-Rooms"
        website="https://simple-chat-rooms.onrender.com/"
      >
        <p>
          A real-time chat platform that allows users to create and join chat rooms without requiring an account. Built with Vue and
          Node.js, it uses Socket.IO to enable real-time communication.
        </p>
        <p><strong>Note:</strong> Due to the free tier limitations of Render, it may take a few seconds to wake up the platform.</p>
      </Project>
    </li>
    <li>
      <Project
        name="ISAL"
        source="https://github.com/SSbit01/Image-Search-Abstraction-Layer"
        website="https://image-search-abstraction-layer.onrender.com/"
      >
        <p>
          An intuitive image search website powered by the <a href="https://pixabay.com/api/docs/" target="_blank" rel="noreferrer noopener"
            >Pixabay API</a
          >. Built with Express, Pug and Bootstrap.
        </p>
        <p><strong>Note:</strong> Due to the free tier limitations of Render, it may take a few seconds to wake up the platform.</p>
      </Project>
    </li>
  </ul>

  <details id="more-projects-details">
    <summary>Other Projects</summary>
    <ul class="project-list">
      <li>
