---
import Project from "#src/components/Project.astro";

const conwayGameOfLifeWiki = "https://en.wikipedia.org/wiki/Conway%27s_Game_of_Life";
---

<script>
  document.getElementById("more-projects-details")?.addEventListener("toggle", function (event) {
    const el = event.target as HTMLDetailsElement;

    if (el.open) {
      el.scrollIntoView(true);
    }
  });
</script>

<section id="projects">
  <h1 class="section-header">These are some of my projects</h1>

  <ul class="project-list">
    <li>
      <Project
        name="Simple Chat Rooms"
        tags={["TypeScript", "Vue", "Pinia", "Stylus", "PWA", "Express", "Socket.IO"]}
        source="https://github.com/SSbit01/Simple-Chat-Rooms"
        website="https://simple-chat-rooms.onrender.com/"
      >
        <p>A platform that allows users to create and join chat rooms without creating an account.</p>
        <p>It uses <strong>WebSockets</strong> to provide real-time chat functionality.</p>
      </Project>
    </li>
    <li>
      <Project
        name="Voting App"
        tags={["TypeScript", "Next.js", "Tailwind CSS", "Headless UI", "PWA", "Mongoose"]}
        source="https://github.com/SSbit01/voting-app"
        website="https://voting-app-iota.vercel.app/"
      >
        <p>A platform where users can create polls and everyone can vote in them.</p>
        <p>It uses a <strong>MongoDB Atlas</strong> database to store users and polls.</p>
      </Project>
    </li>
    <li>
      <Project
        name="HandyVoid"
        tags={["Nuxt", "TypeScript", "Vue", "Stylus", "PWA", "i18n"]}
        source="https://github.com/HandyVoid/HandyVoidium"
        website="https://www.handyvoid.com/"
      >
        <p>
          A multilingual platform that offers a comprehensive set of tools for a wide range of tasks. It aims to provide users with a single
          platform where they can find all the tools they need without having to navigate through multiple websites.
        </p>
      </Project>
    </li>
    <li>
      <Project
        name="ISAL"
        tags={["Express", "Pug", "Bootstrap", "Mongoose", "Pixabay API"]}
        source="https://github.com/SSbit01/Image-Search-Abstraction-Layer"
        website="https://image-search-abstraction-layer.onrender.com/"
      >
        <p>
          A simple and easy-to-use image search website that makes use of the <a
            href="https://pixabay.com/api/docs/"
            target="_blank"
            rel="noreferrer noopener">Pixabay API</a
          >.
        </p>
        <p>It can store search strings in a <strong>MongoDB Atlas</strong> database.</p>
      </Project>
    </li>
    <li>
      <Project
        name="Game Of Life"
        tags={["Vue", "Stylus"]}
        source="https://codepen.io/ssbit01/pen/YzZRQNV"
        website="https://codepen.io/ssbit01/full/YzZRQNV"
      >
        <p>My own implementation of <a href={conwayGameOfLifeWiki} target="_blank" rel="noreferrer noopener">Conway's Game Of Life</a>.</p>
        <p>
          <a href={conwayGameOfLifeWiki} target="_blank" rel="noreferrer noopener">Conway's Game of Life</a> is a cellular automaton where cells
          live or die based on the number of live neighbors they have. It is a simple, but many complex patterns can emerge.
        </p>
        <p>This is one of my favorite projects &lt;3</p>
      </Project>
    </li>
  </ul>

  <details id="more-projects-details">
    <summary>Other Projects</summary>
    <ul class="project-list">
      <li>
