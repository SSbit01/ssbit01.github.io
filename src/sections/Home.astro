---
import { Icon } from "astro-iconify";
---

<section id="home">
  <div id="intro">
    <h1>Hello World, I'm <a href="#about" id="me">Stefan Samson</a></h1>
    <h2 id="headline">An <mark>enthusiast</mark> coder of the <mark>cosmos</mark></h2>
    <a href="#about" title="There are some beautiful things below ;)" id="scroll-down"><Icon name="icon-park-outline:double-down" /></a>
  </div>
</section>

<style lang="scss">
  #home {
    display: grid;
    animation: 40s ease infinite dynamic-bg;
    border-bottom: thin solid;
    background: rgb(10, 15, 20) linear-gradient(135deg, rgb(30, 50, 60), rgb(10, 20, 30), rgb(10, 15, 20), rgb(20, 20, 10), rgb(30, 30, 15));
    background-size: 400% 400%;
    min-height: 100vh;
    color: mediumspringgreen;
  }

  #intro {
    transform-origin: top;
    font-size: clamp(0.9em, 5.2vmin, 1.5em);
    text-align: center;
    $px: 1.5rem;
    animation: 1.75s ease home;
    margin: auto;
    padding: 0 $px 5em $px;

    mark {
      position: relative;
      background: inherit;
      color: aquamarine;
      font-style: italic;
      white-space: nowrap;
      &::after {
        position: absolute;
        right: 0;
        bottom: 0;
        left: 0;
        transform: scaleX(0);
        transform-origin: center;
        transition: transform 0.15s;
        border-radius: 2px;
        background: mediumturquoise;
        height: 2px;
        content: "";
      }
      &:hover::after {
        transform: scaleX(1);
      }
    }
    > h1:first-child {
      font-size: clamp(2em, 10vmin, 2.5em);
      line-height: 1.25;
    }
  }

  #me {
    position: relative;
    color: aquamarine;
    font-style: italic;
    text-decoration: underline double paleturquoise;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    text-shadow: 0 0 3px;
    white-space: nowrap;
    &::after {
      position: absolute;
      transform: scaleX(0);
      transform-origin: right;
      transition:
        background 0.15s,
        transform 0.2s,
        box-shadow 0.2s;
      inset: 0;
      box-shadow: 0 0 8px teal;
      border-radius: 4px;
      background: mediumaquamarine;
      content: "SSbit01";
      color: black;
      font-weight: 400;
    }
    &:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }
    &:active {
      user-select: none;
      &::after {
        box-shadow: 0 0 12px mediumaquamarine;
        background: aquamarine;
      }
    }
  }

  #headline {
    color: lightseagreen;
    line-height: 1.25;
    &::after {
      display: inline-block;
      vertical-align: sub;
      animation: 1s infinite step-end caret;
      margin: 0 0.35em;
      box-shadow: 0 0 6px lightcyan;
      border-radius: 2px;
      background: lightcyan;
      width: 0.2em;
      height: 1em;
      content: "";
    }
  }

  #scroll-down {
    display: inline-block;
    filter: drop-shadow(0 0 3px darkslateblue);
    animation: 1s infinite bounce;
    transition-duration: 0.2s;
    transition-property: color, filter, scale;
    margin-top: 0.5em;
    width: clamp(3em, 9vmin, 4em);
    color: cadetblue;
    &:hover {
      filter: drop-shadow(0 0 3px teal);
      color: mediumaquamarine;
    }
    &:active {
      scale: 0.9;
      filter: drop-shadow(0 0 4px lightseagreen);
      color: aquamarine;
    }
  }

  @keyframes dynamic-bg {
    50% {
      background-position: 100% 100%;
    }
  }

  @keyframes home {
    from,
    50% {
      opacity: 0;
      border-radius: 4em;
      background: seagreen;
      pointer-events: none;
    }
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  @keyframes bounce {
    50% {
      transform: translateY(20%);
    }
  }
</style>
