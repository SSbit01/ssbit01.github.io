---
import { Icon } from "astro-iconify";

import Skill from "#src/components/Skill.astro";
---

<section id="about">
  <div id="about-container">
    <figure id="avatar">
      <img src="https://avatars.githubusercontent.com/u/59541034" alt="Avatar" loading="lazy" draggable="false" />
      <figcaption>GitHub Picture</figcaption>
    </figure>

    <div id="about-me">
      <h1 class="title-section"><a href="#about-me">About Me</a></h1>
      <p>I'm <strong>Stefan Samson</strong>, also known as <em><strong>SSbit01</strong></em>, a simple enthusiast coder.</p>
      <p>
        My curiosity for <strong>science</strong> and <strong>technology</strong> led me to learn <em>C</em> and <em>Python</em> as my first programming
        languages.
      </p>
      <p>
        Subsequently, I've expanded my knowledge in <strong>web development & optimization</strong>, <strong>authentication systems</strong
        >, <strong>security</strong> and <strong>search engine optimization (SEO)</strong>.
      </p>
    </div>
  </div>

  <fieldset id="interests">
    <legend>Interests</legend>

    <ul>
      {
        [
          { icon: "mdi:code-braces", text: "Coding" },
          { icon: "hugeicons:artificial-intelligence-02", text: "Artificial Intelligence" },
          { icon: "mdi:microsoft-windows-classic", text: "Retrocomputing" },
          { icon: "ph:game-controller-duotone", text: "Video Games & Modding" },
          { icon: "eos-icons:atom-electron", text: "Physics" },
          { icon: "ph:planet-duotone", text: "Astronomy" },
          { icon: "file-icons:fossil", text: "Paleontology" }
        ].map(({ icon, text }) => (
          <li>
            <Icon name={icon} />
            {text}
          </li>
        ))
      }
    </ul>
  </fieldset>

  <div id="skill-set">
    <h1 class="title-section"><a href="#tech-stack">Tech Stack</a></h1>

    <fieldset id="front-end">
      <legend><a href="#front-end">Programming Languages</a></legend>
      <Skill icon="skill-icons:javascript">JavaScript</Skill>
      <Skill icon="skill-icons:typescript">TypeScript</Skill>
      <Skill icon="logos:python">Python</Skill>
      <Skill icon="vscode-icons:file-type-java">Java</Skill>
      <Skill icon="logos:bash-icon">Bash</Skill>
    </fieldset>

    <fieldset id="front-end">
      <legend><a href="#front-end">Front-End</a></legend>
      <Skill icon="vscode-icons:file-type-html">HTML5</Skill>
      <Skill icon="vscode-icons:file-type-css">CSS</Skill>
      <Skill icon="logos:sass">Sass</Skill>
      <Skill icon="devicon:bootstrap">Bootstrap</Skill>
      <Skill icon="logos:tailwindcss-icon">Tailwind CSS</Skill>
      <Skill icon="devicon:jquery">jQuery</Skill>
      <Skill icon="logos:react">React</Skill>
      <Skill icon="logos:svelte-icon">Svelte</Skill>
      <Skill icon="logos:vue">Vue</Skill>
    </fieldset>

    <fieldset id="back-end">
      <legend><a href="#back-end">Back-End</a></legend>
      <Skill icon="logos:bun">Bun</Skill>
      <Skill icon="logos:cloudflare-workers-icon">Cloudflare Workers</Skill>
      <Skill icon="vscode-icons:file-type-deno">Deno</Skill>
      <Skill icon="logos:nodejs-icon-alt">Node.js</Skill>
      <Skill icon="simple-icons:express">Express</Skill>
      <Skill icon="logos:hono">Hono</Skill>
      <Skill icon="logos:supabase-icon">Supabase</Skill>
      <Skill icon="logos:spring-icon">Spring</Skill>
    </fieldset>

    <fieldset id="meta">
      <legend><a href="#meta">Meta Frameworks</a></legend>
      <Skill icon="logos:nextjs-icon">Next.js</Skill>
      <Skill icon="logos:nuxt-icon">Nuxt</Skill>
      <Skill icon="logos:svelte-icon">SvelteKit</Skill>
      <Skill icon="vscode-icons:file-type-astro">Astro</Skill>
    </fieldset>

    <fieldset id="databases">
      <legend><a href="#databases">Databases</a></legend>
      <Skill icon="logos:mariadb-icon">MariaDB</Skill>
      <Skill icon="devicon:mongodb">MongoDB</Skill>
      <Skill icon="logos:mysql-icon">MySQL</Skill>
      <Skill icon="logos:postgresql">PostgreSQL</Skill>
      <Skill icon="devicon:sqlite">SQLite</Skill>
      <Skill icon="devicon:redis">Redis</Skill>
    </fieldset>

    <fieldset id="data-analysis">
      <legend><a href="#data-analysis">Data Analysis</a></legend>
      <Skill icon="simple-icons:pandas">Pandas</Skill>
      <Skill icon="logos:matplotlib-icon">Matplotlib</Skill>
      <Skill icon="logos:seaborn-icon">Seaborn</Skill>
      <Skill icon="logos:d3">D3.js</Skill>
    </fieldset>

    <fieldset id="continuous-deployment">
      <legend><a href="#continuous-deployment">Continuous Deployment</a></legend>
      <Skill icon="logos:docker-icon">Docker</Skill>
      <Skill icon="devicon:podman">Podman</Skill>
    </fieldset>
  </div>
</section>

<style lang="scss">
  .title-section {
    font-size: clamp(1.4em, 8vw, 2em);
    > a:first-child {
      position: relative;
      transition: color 0.15s;
      color: #3cb371;
      text-decoration: none;
      &::before {
        position: absolute;
        right: 0;
        bottom: -4px;
        left: 0;
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.25s;
        border-radius: 2px;
        background: #48d1cc;
        height: 2px;
        content: "";
      }
      &::after {
        position: absolute;
        right: -1em;
        opacity: 0;
        transition: opacity 0.15s;
        content: "#";
        color: #2f4f4f;
      }
      &:hover,
      &:focus {
        color: #00fa9a;
        &::after {
          opacity: 1;
        }
      }
      &:active::before {
        transform: scaleX(1);
        transform-origin: left;
      }
    }
  }

  #about {
    background: #0a0f14 linear-gradient(135deg, #192328, #0a0f14);
    $px: 1em;
    border-bottom: thin solid #00fa9a;
    padding: 0 $px 5em $px;
  }

  #about-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.5em 2em;
    padding-top: 2em;
  }

  #avatar {
    margin: 0;
    > img:first-of-type {
      transition:
        box-shadow 0.2s,
        translate 0.15s;
      box-shadow: 0 0 8px #008080;
      border-radius: 50%;
      width: 12em;
      max-width: 100%;
      user-select: none;
      &:hover {
        box-shadow: 0 0 12px 2px #00ff7f;
      }
      &:active {
        translate: 0 -0.5em;
      }
    }
    > figcaption:last-of-type {
      margin-top: 1em;
      color: #dcdcdc;
      font-size: 0.875em;
      text-align: center;
    }
  }

  #about-me {
    max-width: 55em;
    scroll-margin-top: 1em;
    > h1:first-child {
      margin-block-start: 0;
    }
    > p {
      font-size: clamp(1em, 3vw, 1.1em);
      line-height: 1.5;
      strong,
      em {
        color: #7fffd4;
      }
      u {
        text-decoration-color: #66cdaa;
      }
      a {
        transition:
          color 0.15s,
          text-shadow 0.15s;
        color: #1e90ff;
        &:hover {
          color: #00bfff;
        }
        &:active {
          text-shadow: 0 0 4px;
        }
      }
      &:last-child::after {
        display: inline-block;
        vertical-align: sub;
        animation: 1s infinite step-end caret;
        margin-left: 0.35em;
        box-shadow: 0 0 3px #e0ffff;
        border-radius: 2px;
        background: #e0ffff;
        width: 0.2em;
        height: 1em;
        content: "";
      }
    }
  }

  #interests {
    margin: 0.5em auto;
    box-shadow: 1px 1px 4px #000000;
    border: thin solid #2f4f4f;
    border-radius: 8px;
    background: #050a0fbf;
    padding-top: 0.75em;
    max-width: 75em;
    > legend:first-child {
      color: #7fffd4;
      font-size: 1.25em;
    }
    > ul {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-evenly;
      gap: 0.75em 1em;
      margin: 0;
      padding: 0;
      list-style: none;
      > li {
        display: flex;
        align-items: center;
        gap: 0.4em;
        color: #5f9ea0;
        > svg {
          width: 1.5em;
          color: #20b2aa;
        }
      }
    }
  }

  #skill-set {
    display: grid;
    justify-content: center;
    gap: 2em;
    margin-top: 2em;
    > h1:first-child {
      margin-bottom: -0.25em;
      text-align: center;
      > a {
        display: inline-flex;
        align-items: center;
        gap: 0.25em;
        > svg:first-child {
          width: 1em;
        }
      }
    }
    > fieldset {
      $gap: 1.25em;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-evenly;
      align-items: center;
      gap: $gap;
      margin-inline: -0.25em;
      box-shadow: 1px 1px 4px #000000;
      border: thin solid #2f4f4f;
      border-radius: 8px;
      background: #050f1480;
      padding: 1em $gap;
      scroll-margin-top: 1em;
      > legend {
        font-size: clamp(1em, 5.75vw, 1.5em);
        > a:first-child {
          display: inline-flex;
          position: relative;
          align-items: flex-end;
          gap: 0.375em;
          transition: color 0.15s;
          color: #20b2aa;
          text-decoration: none;
          &::before {
            position: absolute;
            right: 0;
            bottom: -3px;
            left: 0;
            transform: scaleX(0);
            transform-origin: right;
            transition: transform 0.25s;
            border-radius: 2px;
            background: #48d1cc;
            height: 2px;
            content: "";
            color: #000000;
          }
          &:hover,
          &:active {
            color: #7fffd4;
          }
          &:active::before {
            transform: scaleX(1);
            transform-origin: left;
          }
          > svg:first-child {
            width: 1.25em;
          }
        }
      }
    }
  }

  @keyframes caret {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 500px) {
    #interests > ul {
      flex-direction: column;
    }
  }
</style>
